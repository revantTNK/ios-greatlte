+	S8_R(s8_vgf_dma, 0x44) = pa;                     /* IN_BASE_ADDR_C */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	S8_R(s8_vgf_dma, 0) |= 1u << 4;                  /* SFR_UPDATE_FORCE */
+}
