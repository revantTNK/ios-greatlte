+	IOLog("S8 DVFS: PLL %u / %u kHz; TMU %d C (trim0 0x%x temp 0x%x 0x%x); target %u / %u\n",
+	    fbig, flit, temp, s8_rd(s8_tmu, 0), s8_rd(s8_tmu, 0x40), s8_rd(s8_tmu, 0x44),
+	    big_khz, lit_khz);
