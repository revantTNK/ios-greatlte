+		}
+		IOLockLock(sweet_fb_stage_lock);
+		sweet_fb_busy = -1;
+		IOLockUnlock(sweet_fb_stage_lock);
+		sweet_fb_wait_ticks += t1 - t0;
+		sweet_fb_panel_ticks += mach_absolute_time() - t1;
+		sweet_fb_panel_copies++;
+	}
+}
