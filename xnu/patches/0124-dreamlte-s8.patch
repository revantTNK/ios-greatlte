+static uint32_t s8_panic_to_recovery;
+uint32_t s8_restart_to_recovery;          /* set by s8autoreset */
+
+static int
+s8_halt_restart(unsigned int type)
+{
+	/* IOPlatformExpert.h: 0 halt, 1 restart, 4 panic restart,
+	 * 9 panic restart without callouts, 10 panic diagnostics done (sent
+	 * after the panic text, before debug.c waits for a KDP debugger over
+	 * serial, which K2b did forever); other types are notifications. */
+	if (s8_pmu == NULL ||
+	    (type != 0 && type != 1 && type != 4 && type != 9 && type != 10)) {
+		return 0;
+	}
+	if (type == 0) {
+		s8_pmu[0x330c / 4] &= ~0x100u;   /* PS_HOLD low: power off */
+		for (;;) {
+		}
+	}
+	uint32_t reason = (s8_restart_to_recovery || (type != 1 && s8_panic_to_recovery)) ?
+	    0x12345674u : 0x12345670u;     /* REASON_RECOVERY / UNKNOWN */
+	s8_pmu[0x808 / 4] = 0x12345678u;     /* INFORM2: SEC_POWER_RESET */
+	s8_pmu[0x80c / 4] = reason;          /* INFORM3 */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	s8_pmu[0x400 / 4] = 1;               /* SWRESET */
+	for (;;) {
+	}
+}
+
+static void
+s8_restart_init(void)
+{
+	uint32_t secs = 0;
+
+	s8_pmu = (volatile uint32_t *)ml_io_map(0x16480000, 0x4000);
+	s8_panic_to_recovery = PE_parse_boot_argn("s8autoreset", &secs, sizeof(secs)) && secs != 0;
+	PE_halt_restart = s8_halt_restart;
+}
+
+/*
+ * Copy of the console in TWRP's ramoops pmsg zone, in persistent_ram
+ * format (sig "DBGC", start, size, ring data), appended to the loader's
+ * text there; TWRP shows it as /sys/fs/pstore/pmsg-ramoops-0 after a warm
+ * reset. Two layouts: the upstream author's TWRP (2 MiB ramoops, pmsg at
+ * 0x92180000) and TWRP 3.4.0 on the galaxios8 G950N (32 KiB ramoops,
+ * 16 KiB pmsg at 0x92004000); both get the text. The small zone wraps,
+ * so it keeps the last ~16 KiB, which is where a panic ends up.
+ */
+struct klog_zone {
+	uint64_t phys, len;
+	volatile uint32_t *hdr;
+	volatile uint8_t *data;
+	uint32_t cap, start, size;
+};
+static struct klog_zone klog_zones[] = {
+	{ .phys = A5_KLOG_PHYS, .len = A5_KLOG_SIZE },
+	{ .phys = A5_KLOG2_PHYS, .len = A5_KLOG2_SIZE },
+};
+static void klog_putc(uint8_t c);
+
+static void
+klog_init(void)
+{
+	for (unsigned i = 0; i < sizeof(klog_zones) / sizeof(klog_zones[0]); i++) {
+		struct klog_zone *z = &klog_zones[i];
+		z->hdr = (volatile uint32_t *)ml_io_map(z->phys, z->len);
+		if (z->hdr == NULL) {
+			continue;
+		}
+		z->cap = (uint32_t)z->len - 12;
+		/* Continue after the loader's text if its header is sane. */
+		if (z->hdr[0] == 0x43474244u && z->hdr[1] == z->hdr[2] && z->hdr[2] < z->cap) {
+			z->start = z->size = z->hdr[2];
+		} else {
+			z->hdr[0] = 0x43474244u;
+			z->start = z->size = 0;
+		}
+		z->data = (volatile uint8_t *)(z->hdr + 3);
+	}
+	const char *banner = "\n--- XNU console ---\n";
+	for (; *banner; banner++) {
+		klog_putc((uint8_t)*banner);
+	}
+	s8_restart_init();
+}
+
+static void
+klog_putc(uint8_t c)
+{
+	for (unsigned i = 0; i < sizeof(klog_zones) / sizeof(klog_zones[0]); i++) {
+		struct klog_zone *z = &klog_zones[i];
+		if (z->data == NULL) {
+			continue;
+		}
+		z->data[z->start] = c;
+		z->start = (z->start + 1) % z->cap;
+		if (z->size < z->cap) {
+			z->size++;
+		}
+		z->hdr[1] = z->start;
+		z->hdr[2] = z->size;
+	}
+}
