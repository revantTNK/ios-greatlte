+		for (uintptr_t i = 0; sweet_fb_copy_lock != NULL && i < SWEET_FB_COPY_HELPERS; i++) {
+			thread_t t;
+			if (kernel_thread_start(sweet_fb_copy_helper, (void *)i, &t) == KERN_SUCCESS) {
+				thread_deallocate(t);
+			}
+		}
+	}
+	int32_t parts = SWEET_FB_COPY_HELPERS + 1;
+	if (sweet_fb_copy_lock == NULL || rows < 64) {
+		struct sweet_fb_copy_job all = { dst, src, dstride, sstride, bytes, rows };
+		sweet_fb_copy_rows(&all);
+		return;
+	}
+	int32_t per = rows / parts, at = 0;
+	IOLockLock(sweet_fb_copy_lock);
+	for (int32_t i = 0; i < SWEET_FB_COPY_HELPERS; i++, at += per) {
+		sweet_fb_jobs[i] = (struct sweet_fb_copy_job){
+			dst + (uint64_t)at * dstride, src + (uint64_t)at * sstride,
+			dstride, sstride, bytes, per };
+	}
