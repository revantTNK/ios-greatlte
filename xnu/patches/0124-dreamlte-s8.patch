+	sweet_fb_copy_gen++;
+	IOLockWakeup(sweet_fb_copy_lock, &sweet_fb_copy_gen, false);
+	IOLockUnlock(sweet_fb_copy_lock);
+	struct sweet_fb_copy_job mine = { dst + (uint64_t)at * dstride, src + (uint64_t)at * sstride,
+		dstride, sstride, bytes, rows - at };
+	sweet_fb_copy_rows(&mine);
+	IOLockLock(sweet_fb_copy_lock);
+	while (sweet_fb_copy_left != 0) {
+		IOLockSleep(sweet_fb_copy_lock, &sweet_fb_copy_left, THREAD_UNINT);
+	}
+	IOLockUnlock(sweet_fb_copy_lock);
+}
