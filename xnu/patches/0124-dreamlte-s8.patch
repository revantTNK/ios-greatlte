+		if (kernel_thread_start(s8_autoreset_thread, NULL, &fallback) == KERN_SUCCESS) {
+			thread_deallocate(fallback);
+		}
+		s8_restart_to_recovery = 1;
+		(void)reboot_kernel(0, (char *)"s8autoreset");
+		for (;;) {
+			(void)tsleep(&chan, PZERO, "s8reset", hz);
+		}
