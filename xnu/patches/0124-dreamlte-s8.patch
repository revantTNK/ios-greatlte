+				uint32_t p2 = in[(acc + 2 * step) >> 16], p3 = in[(acc + 3 * step) >> 16];
+				acc += 4 * step;
+				r[x] = p0;
+				r[x + 1] = p1;
+				r[x + 2] = p2;
+				r[x + 3] = p3;
+			}
+			for (; x < n; x++, acc += step) {
