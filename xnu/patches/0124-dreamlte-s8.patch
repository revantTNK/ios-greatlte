+/*
+ * Boot 31 video: torn frames (top half of one screen, bottom of the
+ * next). DECON_F fetches the panel memory at 60 Hz (boot 30 probe: 30
+ * frame-done events per 0.5 s) while we copy into it. Start each copy
+ * right after a frame-done (INTERRUPT_PENDING 0x4c bit 13, source
+ * enabled in INTERRUPT_ENABLE 0x40; the SPI is not routed), so the copy
+ * runs ahead of the next fetch.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+static vm_offset_t sweet_fb_decon;
+
+#define S8_R(b, o) (*(volatile uint32_t *)((b) + (o)))
+static void
+sweet_fb_dpu_dump(void)
+{
+	vm_offset_t dec = ml_io_map(0x12860000, 0x2000);
+	vm_offset_t dpp = ml_io_map(0x12850000, 0x7000);
+	vm_offset_t dma = ml_io_map(0x128B0000, 0x7000);
+	if (dec == 0 || dma == 0 || dpp == 0) {
+		return;
+	}
+	IOLog("S8 DPU: decon global 0x%x update 0x%x path0 0x%x path1 0x%x path2 0x%x\n",
+	    S8_R(dec, 0), S8_R(dec, 0x60), S8_R(dec, 0x214), S8_R(dec, 0x218), S8_R(dec, 0x230));
+	for (uint32_t w = 0; w < 6; w++) {
+		vm_offset_t b = dec + 0x1000 + w * 0x30;
+		IOLog("S8 DPU: win%u 0x%x 0x%x 0x%x 0x%x 0x%x 0x%x 0x%x 0x%x\n", w,
+		    S8_R(b, 0), S8_R(b, 4), S8_R(b, 8), S8_R(b, 0xc), S8_R(b, 0x10),
+		    S8_R(b, 0x14), S8_R(b, 0x18), S8_R(b, 0x1c));
+	}
+	IOLog("S8 DPU: dma version 0x%x ch_map 0x%x glb 0x%x\n",
+	    S8_R(dma, 0), S8_R(dma, 4), S8_R(dma, 0x40));
+	for (uint32_t c = 0; c < 6; c++) {
+		vm_offset_t i = dma + 0x1000 + c * 0x1000, d = dpp + 0x1000 + c * 0x1000;
+		IOLog("S8 DPU: ch%u idma en 0x%x in 0x%x out 0x%x src 0x%x off 0x%x img 0x%x y 0x%x"
+		    " | dpp en 0x%x in 0x%x img 0x%x scaled 0x%x h 0x%x v 0x%x\n", c,
+		    S8_R(i, 0), S8_R(i, 8), S8_R(i, 0xc), S8_R(i, 0x10), S8_R(i, 0x14),
+		    S8_R(i, 0x18), S8_R(i, 0x40), S8_R(d, 0), S8_R(d, 8), S8_R(d, 0x18),
+		    S8_R(d, 0x2c), S8_R(d, 0x44), S8_R(d, 0x48));
+	}
+}
+
+static void
+sweet_fb_wait_frame_done(void)
+{
+	if (sweet_fb_decon == 0) {
+		sweet_fb_decon = ml_io_map(0x12860000, 0x1000);
+		if (sweet_fb_decon == 0) {
+			return;
+		}
+		*(volatile uint32_t *)(sweet_fb_decon + 0x40) |= (1u << 13) | 1u;
+		uint32_t dump = 0;
+		if (PE_parse_boot_argn("s8dpudump", &dump, sizeof(dump)) && dump) {
+			sweet_fb_dpu_dump();
+		}
+	}
+	volatile uint32_t *pend = (volatile uint32_t *)(sweet_fb_decon + 0x4c);
+	*pend = 1u << 13;
+	for (int i = 0; i < 200 && !(*pend & (1u << 13)); i++) {
+		IODelay(100);
+	}
+}
